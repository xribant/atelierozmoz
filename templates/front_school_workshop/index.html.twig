{% extends 'base.html.twig' %}

{% block title %}Dans les écoles
{% endblock %}

{% block bodyType %}<body class="sub_page">{% endblock %}
{% block content %}
</body>
</div>

<!-- Prochaines sessions -->
<section class="infos-formations">
	<div class="container">
		<div class="row">
			<div class="col-lg-12" data-aos="fade-right">
				<h1 class="mt-5 mb-5">
					<i class="fa-solid fa-graduation-cap"></i>
					Dans les écoles...
				</h1>
			</div>
		</div>
		<div class="row">
			<div class="col-lg-12 col-md-12" data-aos="fade-up">

				<p>
					Ôzmoz intervient directement au sein des écoles pour proposer des ateliers adaptés aux élèves et aux équipes éducatives.
				</p>
				<p>
					Ces interventions sont construites sur mesure et peuvent être organisées à la demande.
				</p>
			</div>
		</div>
	</div>
</section>
<!-- Fin prochaines sessions -->

<!-- Liste des ateliers en écoles -->
  <section class="infos-sessions">
    <div class="container">
      <div class="row mt-5">

           {% for schoolWorkshop in schoolWorkshops %}
              <div class="col-lg-4 col-md-6 col-sm-1">
                <div class="card">
                  <div class="event-img" style="background-image: url('{{ vich_uploader_asset(schoolWorkshop, 'imageFile') }}');"></div>
                  <div class="card-body">
                    <h2 class="card-title">{{ schoolWorkshop.title }}</h2>

                      <!-- Modal -->
                      <div class="modal fade" id="exampleModal{{ schoolWorkshop.uid }}" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
                        <div class="modal-dialog" role="document">
                          <div class="modal-content">
                            <div class="modal-header">
                              <h5 class="modal-title" id="exampleModalLabel"><i class="fa-solid fa-circle-info"></i> Description</h5>
                            </div>
                            <div class="modal-body">
                              {{ schoolWorkshop.description|raw }}
                            </div>
                            <div class="modal-footer">
                              <button type="button" class="btn btn-secondary" data-dismiss="modal">Fermer</button>
                            </div>
                          </div>
                        </div>
                      </div>

                    <div class="d-flex justify-content-center">
                        <a href="{{ path('app_school_workshop_quote_request', {'slug': schoolWorkshop.slug}) }}"><i class="fa-solid fa-file-lines"></i> Devis</a>
                       	{% if schoolWorkshop.description == true %}
                        	<a class="ml-3" href="" data-toggle="modal" data-target="#exampleModal{{ schoolWorkshop.uid }}"><i class="fa-solid fa-circle-info"></i> Détails</a>
                      	{% endif %}
                    </div>
                  </div>
                </div>
              </div>
            {% else %}
              <div class="col-lg-4 col-md-6 col-sm-1">
                Pas d'ateliers en écoles planifiés
              </div>
            {% endfor %}

      </div>
    </div>
  </section>
  <!-- Fin liste des ateliers en écoles -->

{% endblock %}
